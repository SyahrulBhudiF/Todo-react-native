{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    ".expo/**",
    "dist/**",
    "web-build/**",
    "coverage/**",
    "ios/**",
    "android/**",
    "app-example/**",
    "expo-env.d.ts"
  ],
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": true
}
